DATABASE_URL=postgresql://postgres:postgres@localhost:5433/dental_portal?schema=public
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=assets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dental_portal
# Use a UUID belonging to the clinic for writes; session-based auth should set this per user.
DEMO_CLINIC_ID=00000000-0000-4000-8000-000000000001
DEMO_DENTIST_ID=00000000-0000-4000-8000-000000000002
AUTH_EMAIL=owner@example.ph
AUTH_PASSWORD=replace-with-a-long-random-password
AUTH_CLINIC_ID=00000000-0000-4000-8000-000000000001
PUBLIC_BOOKING_CLINIC_ID=00000000-0000-4000-8000-000000000001
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
